/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ampfalaeris/envmetag Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // Defaults for processes without a label; labelled processes and the overrides below take precedence
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // Labels keep the nf-core defaults; processes whose label is far off measured use are overridden by
    // name at the end of this block. See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }

    //
    // Per-process sizes from the first test_full run (DECISIONS.md, 2026-10-27; 1M read pairs per sample,
    // full GlobDB). Memory: measured peak with headroom, doubled on retry after an out-of-memory exit.
    // Time: allows samples ~50x larger, since run time grows with read count.
    // withName takes precedence over withLabel.
    //
    withName: 'BOWTIE2_BUILD' {
        // PhiX (5 kb) only; label process_high asked for 12 CPUs / 72 GB. Peak 10 MB
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withName: 'BOWTIE2_ALIGN' {
        // against PhiX; label process_high. Peak 125 MB, 32 s per 1M pairs
        cpus   = { 4                   }
        memory = { 2.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'FASTP' {
        // label process_medium (36 GB). Peak 1.3 GB, 14 s per 1M pairs
        cpus   = { 4                   }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'FASTQC_RAW|FASTQC_TRIMMED' {
        // label process_low (12 GB). Peak 0.74 GB
        memory = { 4.GB * task.attempt }
    }
    withName: 'HOSTILE_CLEAN' {
        // Bowtie2 against the human index; label process_low (2 CPUs, 12 GB). Peak 2.9 GB (index-bound), 65 s per 1M pairs.
        // Kept under 8 GB so it runs on an 8 GB machine (the local executor refuses larger requests)
        cpus   = { 4                   }
        memory = { 6.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withName: 'SINGLEM_PIPE' {
        // label process_medium (36 GB). Peak 1.0 GB with the full GlobDB metapackage, 3.6 min per 1M pairs.
        // 4 GB keeps SingleM runnable on a laptop (CLAUDE.md); a retry after an out-of-memory exit gets 8 GB
        cpus   = { 4                   }
        memory = { 4.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withName: 'SINGLEM_PROKARYOTICFRACTION' {
        // label process_low (12 GB). Peak 0.23 GB
        memory = { 2.GB * task.attempt }
    }
}
