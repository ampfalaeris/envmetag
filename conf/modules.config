/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// Outputs are published by the workflow `output {}` block in main.nf (with index files), not publishDir.

process {

    // raw and trimmed FastQC share a module; distinct prefixes keep their reports apart in MultiQC
    withName: 'FASTQC_RAW' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_raw" }
    }

    withName: 'FASTQC_TRIMMED' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_trimmed" }
    }

    withName: 'BOWTIE2_ALIGN' {
        ext.prefix = { "${meta.id}_phix" }
    }

    withName: 'HOSTILE_CLEAN' {
        // Casava 1.8+ headers (`@ID 1:N:0:0` / `@ID 2:N:0:0`) keep mate IDs identical; Hostile's default
        // `@ID/1` / `@ID/2` breaks tools that pair mates by ID (SingleM coverage 1.6x, see DECISIONS.md)
        ext.args = '--casava'
    }

    withName: 'SINGLEM_PREPAREMETAPACKAGE' {
        // keep the extracted metapackage (~17 GB for GlobDB r232) once per machine; later runs skip the
        // download and extraction entirely. The workflow requires --singlem_db_cache when downloading.
        storeDir = { params.singlem_db_cache }
    }

    withName: 'SINGLEM_PIPE' {
        // test profile sets `diamond`: the CI metapackage has no nucleotide SDB (see DECISIONS.md)
        ext.args = { params.singlem_assignment_method ? "--assignment-method ${params.singlem_assignment_method}" : '' }
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }

}
