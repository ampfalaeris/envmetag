/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run ampfalaeris/envmetag -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Full tier (1M read pairs + spikes per sample) with the full GlobDB r232 metapackage and SingleM's default
    // assignment method. Run before every release and note the run in CHANGELOG.md (see DECISIONS.md).
    // Samplesheet: repository copy with Zenodo URLs, or ENVMETAG_TESTDATA_BASE for a local build (as in test.config).
    input               = System.getenv('ENVMETAG_TESTDATA_BASE') ? System.getenv('ENVMETAG_TESTDATA_BASE') + 'samplesheet_full.csv' : "${projectDir}/tests/testdata/samplesheet_full.csv"
    // Full metapackage (17 GB extracted): ENVMETAG_SINGLEM_METAPACKAGE or --singlem_metapackage; otherwise the
    // pipeline downloads it (set --singlem_db_cache to keep one copy across runs)
    singlem_metapackage = System.getenv('ENVMETAG_SINGLEM_METAPACKAGE') ?: null
}
