/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run ampfalaeris/envmetag -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data: tiny tier (100k read pairs per sample) and the 3-marker CI metapackage.
    // The samplesheet with Zenodo URLs lives in the repository (written by build_testdata.sh with the record's
    // URL prefix), so a URL fix is a commit, not a new Zenodo version. ENVMETAG_TESTDATA_BASE points at a local
    // build instead (its samplesheet has local paths).
    input               = System.getenv('ENVMETAG_TESTDATA_BASE') ? System.getenv('ENVMETAG_TESTDATA_BASE') + 'samplesheet_tiny.csv' : "${projectDir}/tests/testdata/samplesheet_tiny.csv"
    // 3-marker CI metapackage, Zenodo record 23679677 (195 MB, ~1 GB extracted in the work directory).
    // ENVMETAG_SINGLEM_CI_METAPACKAGE points at an already-extracted copy instead (CI caches one).
    singlem_metapackage     = System.getenv('ENVMETAG_SINGLEM_CI_METAPACKAGE') ?: null
    singlem_metapackage_url = 'https://zenodo.org/records/23679677/files/GlobDB_r232_ci3.smpkg.tar.gz'

    // The 3-marker CI metapackage has no nucleotide SDB, so the default assignment method fails (see DECISIONS.md)
    singlem_assignment_method = 'diamond'

    // Hostile's small human-mitochondrion index (listed by `hostile index list`, Hostile 2.0.2)
    hostile_index = 'test-human-mit'
}
