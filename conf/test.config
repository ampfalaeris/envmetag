/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run ampfalaeris/envmetag -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // tiny tier (20k read pairs per sample) and the 3-marker CI metapackage. Until the Zenodo
    // records exist, point these at local copies via environment variables.
    input               = (System.getenv('ENVMETAG_TESTDATA_BASE') ?: 'ZENODO_RECORD_PENDING/') + 'tiny/samplesheet.csv'
    singlem_metapackage = System.getenv('ENVMETAG_SINGLEM_CI_METAPACKAGE') ?: 'ZENODO_RECORD_PENDING'

    // The 3-marker CI metapackage has no nucleotide SDB, so the default assignment method fails (see DECISIONS.md)
    singlem_assignment_method = 'diamond'

    // Hostile's small human-mitochondrion index (listed by `hostile index list`, Hostile 2.0.2)
    hostile_index = 'test-human-mit'
}
