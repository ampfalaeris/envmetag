nextflow_workflow {

    name "Test Subworkflow PROFILE_SINGLEM"
    script "../main.nf"
    workflow "PROFILE_SINGLEM"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "profile_singlem"
    tag "singlem"

    // SingleM runs on fastp-trimmed reads in the pipeline (DECISIONS.md, 2026-10-26), so the tests do too:
    // the nf-core FASTP module with the pipeline's own (default) arguments
    setup {
        run("FASTP") {
            script "../../../../modules/nf-core/fastp/main.nf"
            process {
                """
                input[0] = channel.of(
                    tuple([id: 'mic_coupon', single_end: false], [
                        file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R1.fastq.gz', checkIfExists: true),
                        file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R2.fastq.gz', checkIfExists: true)
                    ], []),
                    tuple([id: 'apb_enrichment', single_end: false], [
                        file(params.envmetag_testdata_base_path + 'tiny/SRR35816318_tiny_R1.fastq.gz', checkIfExists: true),
                        file(params.envmetag_testdata_base_path + 'tiny/SRR35816318_tiny_R2.fastq.gz', checkIfExists: true)
                    ], [])
                )
                input[1] = false
                input[2] = false
                input[3] = false
                """
            }
        }
    }

    test("two MIC samples, tiny tier, CI metapackage") {

        when {
            workflow {
                """
                input[0] = FASTP.out.reads.map { meta, reads ->
                    record(
                        id: meta.id,
                        r1: reads.find { f -> f.name.endsWith('_R1.fastp.fastq.gz') },
                        r2: reads.find { f -> f.name.endsWith('_R2.fastp.fastq.gz') }
                    )
                }
                input[1] = channel.value(file(params.singlem_ci_metapackage, checkIfExists: true))
                """
            }
        }

        then {
            assert workflow.success
            def profiles = workflow.out.profiles.sort { r -> r.id }
            def fractions = workflow.out.fractions.sort { r -> r.id }
            def fraction_by_id = fractions.collectEntries { r -> [r.id, r] }
            def summary = workflow.out.summary[0]
            def fraction_row = { r ->
                def lines = path(r.fraction).readLines()
                [lines[0].split('\t') as List, lines[1].split('\t', -1) as List].transpose().collectEntries()
            }
            assertAll(
                { assert profiles*.id == ['apb_enrichment', 'mic_coupon'] },
                { assert fractions*.id == ['apb_enrichment', 'mic_coupon'] },
                // each fraction must be computed from that sample's own reads:
                // bases in each sample's fastp output (fastp JSON and awk agree). Hardcoded because nf-test 0.9.4
                // does not expose setup outputs in `then`; a fastp version or argument change will change them.
                { assert fraction_row(fraction_by_id.mic_coupon).sample == 'mic_coupon' },
                { assert fraction_row(fraction_by_id.mic_coupon).metagenome_size as long == 28922250L },
                { assert fraction_row(fraction_by_id.apb_enrichment).sample == 'apb_enrichment' },
                { assert fraction_row(fraction_by_id.apb_enrichment).metagenome_size as long == 24819804L },
                // one summary across all samples, columns in sorted sample order
                { assert path(summary.combined).readLines().drop(1).collect { l -> l.split('\t')[0] }.toUnique() == ['apb_enrichment', 'mic_coupon'] },
                { assert path(summary.by_rank.find { f -> f.toString().endsWith('-genus.tsv') }).readLines()[0] == 'taxonomy\tapb_enrichment\tmic_coupon' },
                { assert snapshot(profiles.collect { r -> path(r.profile) }, path(summary.extras)).match() }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    record(
                        id: 'mic_coupon',
                        r1: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R1.fastq.gz', checkIfExists: true),
                        r2: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R2.fastq.gz', checkIfExists: true)
                    )
                )
                input[1] = channel.value(file(params.singlem_ci_metapackage, checkIfExists: true))
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.profiles*.id == ['mic_coupon'] },
                { assert workflow.out.fractions*.id == ['mic_coupon'] },
                { assert workflow.out.summary.size() == 1 }
            )
        }
    }
}
