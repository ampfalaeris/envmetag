/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/envmetag/'

    // envmetag test data (tiny tier) and the 3-marker SingleM CI metapackage.
    // Until the Zenodo records exist, point these at local copies via environment variables.
    envmetag_testdata_base_path = System.getenv('ENVMETAG_TESTDATA_BASE') ?: 'ZENODO_RECORD_PENDING/'
    singlem_ci_metapackage      = System.getenv('ENVMETAG_SINGLEM_CI_METAPACKAGE') ?: 'ZENODO_RECORD_PENDING'
}

// CI runners have 16 GB; set NFT_MAX_MEMORY (e.g. '7.GB') on smaller local machines.
// This file is passed with -c, so it takes precedence over the test profile's limits.
process {
    resourceLimits = [
        cpus: 4,
        memory: System.getenv('NFT_MAX_MEMORY') ?: '15.GB',
        time: '1.h'
    ]
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
