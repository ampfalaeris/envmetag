nextflow_process {

    name "Test Process SINGLEM_PROKARYOTICFRACTION"
    script "../main.nf"
    process "SINGLEM_PROKARYOTICFRACTION"

    tag "modules"
    tag "modules_local"
    tag "singlem"
    tag "singlem/prokaryoticfraction"

    setup {
        run("SINGLEM_PIPE") {
            script "../../pipe/main.nf"
            process {
                """
                input[0] = channel.of(
                    record(
                        id: 'mic_coupon',
                        r1: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R1.fastq.gz', checkIfExists: true),
                        r2: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R2.fastq.gz', checkIfExists: true)
                    )
                )
                input[1] = file(params.singlem_ci_metapackage, checkIfExists: true)
                """
            }
        }
    }

    test("tiny tier, CI metapackage") {

        when {
            process {
                """
                input[0] = SINGLEM_PIPE.out[0].map { p ->
                    record(
                        id: p.id,
                        r1: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R1.fastq.gz', checkIfExists: true),
                        r2: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R2.fastq.gz', checkIfExists: true),
                        profile: p.profile
                    )
                }
                input[1] = file(params.singlem_ci_metapackage, checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            def r = process.out[0][0]
            def lines = path(r.fraction).readLines()
            def header = lines[0].split('\t') as List
            def row = [header, lines[1].split('\t', -1) as List].transpose().collectEntries()
            assertAll(
                { assert r.id == 'mic_coupon' },
                { assert lines.size() == 2 },
                { assert header.take(6) == ['sample', 'bacterial_archaeal_bases', 'metagenome_size', 'read_fraction', 'average_bacterial_archaeal_genome_size', 'warning'] },
                { assert row.sample == 'mic_coupon' },
                // bases in the 100,000 input pairs (counted independently with awk; spikes are 126 bp):
                // SingleM must count the same reads that produced the profile
                { assert row.metagenome_size as long == 29909616L },
                // the value itself is meaningless on the 3-marker CI metapackage (DECISIONS.md); only its range is checked
                { assert (row.read_fraction as double) >= 0 && (row.read_fraction as double) <= 100 }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(
                    record(
                        id: 'mic_coupon',
                        r1: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R1.fastq.gz', checkIfExists: true),
                        r2: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R2.fastq.gz', checkIfExists: true),
                        profile: file(params.envmetag_testdata_base_path + 'tiny/SRR12174148_tiny_R1.fastq.gz', checkIfExists: true)
                    )
                )
                input[1] = file(params.singlem_ci_metapackage, checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out[0][0].fraction).readLines()
            assertAll(
                { assert lines.size() == 2 },
                { assert lines[0].startsWith('sample\tbacterial_archaeal_bases\tmetagenome_size\tread_fraction') },
                { assert lines[1].split('\t')[0] == 'mic_coupon' }
            )
        }
    }
}
